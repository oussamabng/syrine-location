# Set this to the real HTTPS origin on your VPS (never include a trailing slash).
PUBLIC_ORIGIN=https://your-real-domain.example
# Absolute paths OUTSIDE the deployment release directory; persist these across upgrades.
SYRINE_DATA_DIR=/var/lib/syrine
SYRINE_DB_PATH=/var/lib/syrine/syrine.sqlite
SYRINE_UPLOAD_DIR=/var/lib/syrine/uploads
# Optional: on FIRST run only; use >= 16 random characters. Never commit your .env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Only one running Next.js instance is supported by this snapshot-based DB adapter.
PORT=3000

# SEO: the content value of the Google Search Console "HTML tag" verification method (optional).
GOOGLE_SITE_VERIFICATION=
